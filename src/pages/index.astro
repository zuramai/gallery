---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PhotoGallery from "../components/PhotoGallery.astro";

const photos = (await getCollection("gallery")).sort((a, b) =>
    a.id.localeCompare(b.id, "en", { numeric: true }),
);
---

<Layout>
    <SiteHeader />
    <main id="main" class="page-shell">
        <PhotoGallery photos={photos} />
    </main>
    <footer class="site-footer page-shell">
        <p>© {new Date().getFullYear()} Ahmad Saugi</p>
        <span class="footer-note">
            Made with curiosity. Captured with care.
        </span>
        <a href="#main"> 
            Back to top <span aria-hidden="true">↑</span>
        </a>
    </footer>
</Layout>

<style>
    .intro {
        padding-top: 55px;
    }
    .intro-kicker {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--muted);
    }
    .intro-kicker span {
        width: 22px;
        height: 1px;
        background: var(--accent);
    }
    .intro-body {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 48px;
        padding: 25px 0 42px;
    }
    h1 {
        margin: 0;
        font-family: var(--cormorant-garamond);
        font-size: clamp(66px, 7.9vw, 112px);
        font-weight: 400;
        line-height: 0.94;
        letter-spacing: -0.045em;
    }
    h1 em {
        font-weight: 400;
        color: var(--accent);
    }
    .intro-note {
        flex: 0 0 260px;
        padding-bottom: 6px;
    }
    .intro-note > :global(svg) {
        margin-bottom: 19px;
        color: var(--accent);
    }
    .intro-note p {
        margin: 0;
        color: #686b61;
        font-size: 12px;
        line-height: 1.9;
    }
    .intro-signature {
        display: block;
        margin-top: 17px;
        font-family: var(--cormorant-garamond);
        font-size: 20px;
        font-style: italic;
    }
    .intro-footnote {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid var(--rule);
        padding: 16px 0;
        color: var(--muted);
    }
    .intro-footnote > :last-child {
        font-family: var(--cormorant-garamond);
        font-size: 18px;
        font-style: italic;
    }
    .endnote {
        padding: 81px 0 87px;
        text-align: center;
        border-top: 1px solid var(--rule);
    }
    .endnote > span {
        color: var(--muted);
    }
    .endnote p {
        margin: 23px 0;
        font-family: var(--cormorant-garamond);
        font-size: clamp(29px, 3.3vw, 44px);
        line-height: 1.16;
        letter-spacing: -0.025em;
    }
    .endnote em {
        color: var(--accent);
    }
    .endnote a {
        display: inline-flex;
        align-items: center;
        gap: 13px;
        padding-block: 8px;
        font-size: 11px;
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
    }
    .endnote a:hover {
        color: var(--accent);
    }
    .site-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        min-height: 81px;
        border-top: 1px solid var(--rule);
        font-size: 10px;
        color: var(--muted);
    }
    .site-footer p {
        margin: 0;
    }
    .footer-note {
        font-family: var(--cormorant-garamond);
        font-size: 16px;
        font-style: italic;
    }
    .site-footer a {
        display: flex;
        align-items: center;
        gap: 13px;
        min-height: 44px;
        text-decoration: none;
    }
    @media (max-width: 900px) {
        .intro-body {
            gap: 25px;
        }
        .intro-note {
            flex-basis: 210px;
        }
        h1 {
            font-size: clamp(60px, 8.5vw, 80px);
        }
        .footer-note {
            display: none;
        }
    }
    @media (max-width: 600px) {
        .intro {
            padding-top: 36px;
        }
        .intro-kicker {
            font-size: 8px;
            letter-spacing: 0.13em;
        }
        .intro-body {
            display: block;
            padding: 28px 0 31px;
        }
        h1 {
            font-size: clamp(54px, 13.8vw, 79px);
        }
        .intro-note {
            margin-top: 26px;
            max-width: 340px;
        }
        .intro-note > :global(svg),
        .intro-signature {
            display: none;
        }
        .intro-note p {
            font-size: 11px;
            line-height: 1.8;
        }
        .intro-footnote .eyebrow {
            font-size: 8px;
            letter-spacing: 0.1em;
        }
        .intro-footnote > :last-child {
            font-size: 15px;
        }
        .endnote {
            padding: 58px 0;
        }
        .endnote .eyebrow {
            font-size: 8px;
        }
        .site-footer {
            font-size: 9px;
        }
    }
</style>
