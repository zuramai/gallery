---
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import PhotoLightbox from "./PhotoLightbox.astro";

interface Props {
    photos: CollectionEntry<"gallery">[];
}

const { photos } = Astro.props;
const tagCounts = new Map<string, number>();
for (const photo of photos) {
    for (const tag of new Set(photo.data.tags)) {
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    }
}
const tags = [...tagCounts.keys()].sort((a, b) => a.localeCompare(b));
const entries = await Promise.all(photos.map(async (photo, index) => {
    const fullImage = await getImage({
        src: photo.data.src,
        width: Math.min(2000, photo.data.src.width),
        format: "webp",
        quality: 90,
    });
    return {
        ...photo.data,
        index,
        fullImage: fullImage.src,
        ratio: photo.data.src.height / photo.data.src.width,
    };
}));

// Balance the native photo proportions without cropping any of the frames.
const columns: typeof entries[] = [[], [], []];
const heights = [0, 0, 0];
for (const photo of entries) {
    const column = heights.indexOf(Math.min(...heights));
    columns[column].push(photo);
    heights[column] += photo.ratio + 0.3;
}
---

<section class="photo-collection" data-gallery aria-label="Photograph collection">
    <div class="collection-toolbar">
        <div class="tag-filters" role="group" aria-label="Filter photographs by tag">
            <button type="button" class="filter-button" data-filter="" aria-pressed="true" aria-controls="photographs">
                All photographs <sup>{String(photos.length).padStart(2, "0")}</sup>
            </button>
            {tags.map((tag) => (
                <button type="button" class="filter-button" data-filter={tag} aria-pressed="false" aria-controls="photographs">
                    {tag} <sup>{tagCounts.get(tag)}</sup>
                </button>
            ))}
        </div>
        <span class="collection-label eyebrow">Selected frames</span>
    </div>

    <p class="filter-status" data-filter-status role="status" aria-live="polite" aria-atomic="true">Showing all {photos.length} photographs</p>

    <div id="photographs" class="gallery-grid" data-gallery-grid>
        {columns.map((column) => (
            <div class="gallery-column" data-gallery-column>
                {column.map((photo) => (
                    <figure class="photo-card" data-photo-index={photo.index} data-photo-ratio={photo.ratio} data-tags={JSON.stringify(photo.tags)}>
                        <a
                            class="photo-link"
                            href={photo.fullImage}
                            data-open-photo
                            data-photo={JSON.stringify({ ...photo, src: undefined, ratio: undefined })}
                            aria-label={`View ${photo.title}, ${photo.location}`}
                            aria-haspopup="dialog"
                            aria-controls="photo-lightbox"
                        >
                            <Image
                                src={photo.src}
                                alt={photo.description}
                                width={Math.min(800, photo.src.width)}
                                widths={[480, 800, 1200]}
                                sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 900px) calc((100vw - 86px) / 2), (max-width: 1432px) calc((100vw - 168px) / 3), 421px"
                                format="webp"
                                quality={85}
                                loading={photo.index < 3 ? "eager" : "lazy"}
                                decoding="async"
                            />
                            <span class="photo-view"><Icon name="expand" size={15} /><span>View photograph</span></span>
                        </a>
                        <figcaption>
                            <div class="photo-heading">
                                <h2>{photo.title}</h2>
                                <span class="photo-number">{String(photo.index + 1).padStart(2, "0")}</span>
                            </div>
                            <p class="photo-location"><Icon name="pin" size={12} />{photo.location}</p>
                            <div class="photo-tags" aria-label="Photo tags">
                                {photo.tags.map((tag) => <button type="button" data-select-tag={tag} aria-label={`Filter by ${tag}`}>{tag}</button>)}
                            </div>
                        </figcaption>
                    </figure>
                ))}
            </div>
        ))}
    </div>

    <noscript><p class="noscript-note">Enable JavaScript to filter the collection and open photo details. You can still click any photograph to view it larger.</p></noscript>
    <PhotoLightbox />
</section>

<script>
    import "../scripts/gallery";
</script>

<style>
    .collection-toolbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 26px; padding: 24px 0 26px; }
    .tag-filters { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 24px; }
    .filter-button { position: relative; border: 0; padding: 11px 0; min-height: 44px; background: transparent; color: var(--muted); font-family: var(--nunito-sans); font-size: 11px; white-space: nowrap; transition: color 160ms ease; }
    .filter-button sup { margin-left: 4px; font-size: 8px; }
    .filter-button::after { content: ""; position: absolute; left: 0; right: 0; bottom: 3px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
    .filter-button[aria-pressed="true"] { color: var(--accent); }
    .filter-button[aria-pressed="true"]::after { transform: scaleX(1); }
    .filter-button:hover { color: var(--ink); }
    .collection-label { flex-shrink: 0; padding-top: 16px; font-size: 8px; color: var(--muted); }
    .filter-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; padding-bottom: 34px; }
    .gallery-grid :global(.gallery-column) { display: flex; flex-direction: column; gap: 38px; min-width: 0; }
    .photo-card { margin: 0; min-width: 0; }
    .photo-link { position: relative; display: block; overflow: hidden; background: #e4e4db; }
    .photo-link :global(img) { display: block; width: 100%; height: auto; transition: transform 650ms cubic-bezier(0.2, 0.7, 0.3, 1); }
    .photo-view { position: absolute; bottom: 16px; right: 16px; display: flex; align-items: center; gap: 9px; padding: 10px 12px; background: rgb(247 245 239 / 95%); font-size: 9px; opacity: 0; transform: translateY(5px); transition: opacity 200ms ease, transform 200ms ease; }
    .photo-link:hover :global(img) { transform: scale(1.025); }
    .photo-link:hover .photo-view, .photo-link:focus-visible .photo-view { opacity: 1; transform: translateY(0); }
    figcaption { padding-top: 15px; }
    .photo-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 15px; }
    h2 { margin: 0; font-family: var(--cormorant-garamond); font-size: clamp(22px, 2vw, 27px); font-weight: 500; line-height: 1.15; letter-spacing: -0.02em; }
    .photo-number { font-size: 9px; color: var(--muted); font-variant-numeric: tabular-nums; }
    .photo-location { display: flex; align-items: center; gap: 5px; margin: 7px 0 5px; color: var(--muted); font-size: 9px; line-height: 1.6; }
    .photo-location :global(svg) { flex-shrink: 0; }
    .photo-tags { display: flex; flex-wrap: wrap; gap: 0 13px; }
    .photo-tags button { position: relative; padding: 7px 0; border: 0; background: transparent; color: var(--muted); font-family: var(--nunito-sans); font-size: 8px; letter-spacing: 0.06em; text-transform: uppercase; }
    .photo-tags button + button::before { content: "·"; position: absolute; left: -8px; }
    .photo-tags button:hover { color: var(--accent); }
    .noscript-note { padding-bottom: 20px; font-size: 12px; color: var(--muted); }
    @media (max-width: 1100px) { .collection-label { display: none; } }
    @media (max-width: 900px) {
        .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
        .tag-filters { gap: 4px 20px; }
    }
    @media (max-width: 600px) {
        .collection-toolbar { padding: 16px 0 23px; }
        .tag-filters { gap: 0 18px; }
        .filter-button { font-size: 10px; padding-block: 9px; }
        .gallery-grid { grid-template-columns: minmax(0, 1fr); }
        .gallery-grid :global(.gallery-column) { gap: 32px; }
        h2 { font-size: 27px; }
        .photo-location { font-size: 10px; }
        .photo-tags button { min-height: 32px; font-size: 9px; }
        .photo-view { padding: 9px; opacity: 1; transform: none; }
        .photo-view span { display: none; }
    }
</style>
