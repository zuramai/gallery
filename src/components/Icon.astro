---
interface Props {
    name: "github" | "linkedin" | "instagram" | "globe" | "arrow-up-right" | "arrow-left" | "arrow-right" | "close" | "pin" | "expand" | "aperture";
    size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {name === "github" && <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.8a3.3 3.3 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.8A5.3 5.3 0 0 0 18.8 4a4.9 4.9 0 0 0-.1-3.6s-1.2-.4-3.9 1.5a13.5 13.5 0 0 0-7 0C5.1 0 3.9.4 3.9.4A4.9 4.9 0 0 0 3.8 4a5.3 5.3 0 0 0-1.5 3.7c0 5.3 3.2 6.5 6.2 6.8a3.3 3.3 0 0 0-.9 2.6v4.2" transform="translate(1 1) scale(.9)" />}
    {name === "linkedin" && <><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M7.5 10v7M7.5 7v.01M11.5 17v-7m0 3a3 3 0 0 1 6 0v4" /></>}
    {name === "instagram" && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><path d="M17.5 6.5h.01" stroke-width="2.5" /></>}
    {name === "globe" && <><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></>}
    {name === "arrow-up-right" && <path d="M6 18 18 6M6 6h12v12" />}
    {name === "arrow-left" && <path d="M19 12H5m6-6-6 6 6 6" />}
    {name === "arrow-right" && <path d="M5 12h14m-6-6 6 6-6 6" />}
    {name === "close" && <path d="m6 6 12 12M6 18 18 6" />}
    {name === "pin" && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2" /></>}
    {name === "expand" && <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" />}
    {name === "aperture" && <><circle cx="12" cy="12" r="9" /><path d="m14.3 3.3 3.2 5.5M20.7 9H14M18.4 18 15 12.2M9.7 20.7l-3.2-5.5M3.3 15H10M5.6 6 9 11.8" /></>}
</svg>
