---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Saugi — A photographic journal",
    description = "A personal photographic journal by Ahmad Saugi. Places, people, and the quiet beauty in between, captured one frame at a time.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f7f5ef" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <Font cssVariable="--cormorant-garamond" preload />
        <Font cssVariable="--nunito-sans" />
        <title>{title}</title>
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to photographs</a>
        <slot />
    </body>
</html>
